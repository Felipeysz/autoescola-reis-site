@* Views/Faq/Index.cshtml *@
@using AutoescolaReisSite.Models
@model List<FaqItem>
@{
    ViewData["Title"] = "Perguntas Frequentes";
    ViewData["Description"] = "Tire suas dúvidas sobre categorias de CNH, prazos, aulas teóricas online e o processo de habilitação na Autoescola Reis.";
}

<section class="faq-hero">
    <div class="container">
        <span class="cursos-eyebrow">Dúvidas comuns</span>
        <h1>Perguntas Frequentes</h1>
    </div>
</section>

<section class="faq-lista">
    <div class="container" itemscope itemtype="https://schema.org/FAQPage">
        @foreach (var item in Model)
        {
            <details class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                <summary itemprop="name">@item.Pergunta</summary>
                <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                    <p itemprop="text">@item.Resposta</p>
                </div>
            </details>
        }
    </div>
</section>

<section class="faq-cta">
    <div class="container">
        <p>Não encontrou o que procurava?</p>
        <div class="cta-grupo">
            <a href="https://wa.me/5571982600856" target="_blank" rel="noopener" class="btn btn--whatsapp">WhatsApp</a>
            <a href="tel:+557134507775" class="btn btn--ligar">Ligar agora</a>
        </div>
    </div>
</section>