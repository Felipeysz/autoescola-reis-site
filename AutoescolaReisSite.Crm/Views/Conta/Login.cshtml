@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <title>Entrar — CRM Autoescola Reis</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/crm.css" />
</head>
<body class="login-page">
    <div class="faixa"></div>
    <div class="login-wrap">
        <div class="login-box">
            <p class="login-eyebrow">Painel interno</p>
            <h1>CRM — Autoescola Reis</h1>

            @if (!string.IsNullOrEmpty(Model.ErroMensagem))
            {
                <p class="erro">@Model.ErroMensagem</p>
            }

            <form asp-action="Login" method="post">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" autofocus />
                <span asp-validation-for="Email"></span>

                <label asp-for="Senha">Senha</label>
                <input asp-for="Senha" type="password" />
                <span asp-validation-for="Senha"></span>

                <button type="submit">Entrar</button>
            </form>
        </div>
    </div>
</body>
</html>