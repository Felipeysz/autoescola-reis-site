@* Views/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Autoescola Reis</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Autoescola Reis: formação de condutores em Salvador - BA há mais de 20 anos. Primeira habilitação A, B e AB, mudança de categoria D e E, curso de reciclagem.")" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Autoescola Reis" />
    <meta property="og:title" content="@ViewData["Title"] - Autoescola Reis" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Autoescola Reis: formação de condutores em Salvador - BA há mais de 20 anos.")" />
    <meta property="og:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)@(ViewData["OgImage"] ?? "/images/og-cover.jpg")" />
    <meta property="og:url" content="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"] - Autoescola Reis" />
    <meta name="twitter:description" content="@(ViewData["Description"] ?? "Autoescola Reis: formação de condutores em Salvador - BA há mais de 20 anos.")" />
    <meta name="twitter:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)@(ViewData["OgImage"] ?? "/images/og-cover.jpg")" />

    <link rel="icon" type="image/png" href="~/images/favicon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <a href="#main-content" class="skip-link">Ir para o conteúdo principal</a>

    <header class="site-header">
        <div class="container site-header-inner">
            <a href="@Url.Action("Index", "Home")" class="site-logo">
                <img src="~/images/marca-autoescola-reis.png" alt="Autoescola Reis" />
            </a>

            <nav class="site-nav" aria-label="Navegação principal">
                <ul>
                    <li><a href="@Url.Action("Index", "Home")">Início</a></li>
                    <li><a href="@Url.Action("Index", "Cursos")">Cursos</a></li>
                    <li><a href="@Url.Action("Sobre", "Home")">Sobre Nós</a></li>
                    <li><a href="@Url.Action("Index", "Noticias")">Notícias</a></li>
                    <li><a href="@Url.Action("Index", "Matriculas")">Matrículas</a></li>
                    <li><a href="@Url.Action("Index", "Faq")">Dúvidas</a></li>
                </ul>
            </nav>

            <button type="button" class="nav-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="site-nav">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <main id="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer-grid">

            <div class="footer-endereco">
                <h2>Endereço e Contatos:</h2>
                <p>
                    Avenida Tancredo Neves, 274, Torre A, Térreo<br />
                    Caminho das Árvores, Salvador – Bahia<br />
                    CEP: 41820-620
                </p>
            </div>

            <div class="footer-horarios">
                <h2>Horários de Funcionamento:</h2>
                <p>(71) 3450-7775 / 3450-4094 / 3231-8559</p>
                <p>
                    <a href="https://wa.me/5571982600856" target="_blank" rel="noopener">
                        (71) 98260-0856 :: Somente WhatsApp
                    </a>
                </p>
                <p>
                    <a href="tel:+557134507775">
                        (71) 3450-7775 :: Ligar agora
                    </a>
                </p>
                <p>
                    <a href="mailto:contato@autoescolareis.com.br">contato@autoescolareis.com.br</a>
                </p>
                <p>SEGUNDA À SEXTA | 08h –18h</p>
                <p>SÁBADOS | 08h –12h</p>
                <p>DOMINGO | Fechado</p>
            </div>

            <div class="footer-links">
                <a href="https://webmail-seguro.com.br/autoescolareis.com.br/" target="_blank" rel="noopener">Webmail</a>
                <span aria-hidden="true">|</span>
                <a href="@Url.Action("Politica", "Home")">Política de Privacidade</a>
            </div>

        </div>

        <div class="container site-footer-bottom">
            <p>Centro de Formações de Condutores Reis Ltda - ME &nbsp; CNPJ: 04.111.185/0001-62</p>
            @* TODO: confirmar com o cliente se mantém o crédito da agência anterior ou remove/substitui *@
            <p><a href="https://www.artworkstudio.com.br/" target="_blank" rel="noopener">Desenvolvido por Artwork Studio ®</a></p>
        </div>
    </footer>

    <a href="https://wa.me/5571982600856"
       target="_blank"
       rel="noopener"
       class="whatsapp-float"
       aria-label="Falar no WhatsApp">
        <img src="~/images/whatsapp-icon.svg" alt="" aria-hidden="true" />
    </a>

<!-- GSAP + ScrollTrigger (gratuito desde abril/2025) — animações em wwwroot/js/animations.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.7/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.7/ScrollTrigger.min.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/animations.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
