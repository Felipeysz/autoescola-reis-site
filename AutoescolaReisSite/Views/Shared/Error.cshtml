@model ErrorViewModel
@{
    ViewData["Title"] = Model.Titulo;
}

<section class="erro-page">
    <div class="container erro-page-conteudo">
        <span class="erro-page-codigo">@Model.StatusCode</span>
        <h1>@Model.Titulo</h1>
        <p>@Model.Mensagem</p>

        <div class="erro-page-cta">
            <a href="@Url.Action("Index", "Home")" class="btn btn--primario">Voltar para o início</a>
            <a href="https://wa.me/5571982600856" target="_blank" rel="noopener" class="btn btn--whatsapp">
                Falar no WhatsApp
            </a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="erro-page-requestid">
                Código de referência: <code>@Model.RequestId</code>
            </p>
        }
    </div>
</section>