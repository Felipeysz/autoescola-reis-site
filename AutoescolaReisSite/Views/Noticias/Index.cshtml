@* Views/Noticias/Index.cshtml *@
@using AutoescolaReisSite.Models
@model NoticiasIndexViewModel
@{
    ViewData["Title"] = "Notícias";
    ViewData["Description"] = "Fique por dentro das últimas notícias sobre trânsito, CNH e habilitação, publicadas pela Autoescola Reis.";
}

<section class="noticias-hero">
    <div class="container">
        <h1>Notícias</h1>
    </div>
</section>

<section class="noticias-lista">
    <div class="container">
        @foreach (var post in Model.Posts)
        {
            <a href="@Url.Action("Detalhes", "Noticias", new { slug = post.Slug })" class="noticia-card">
                @if (!string.IsNullOrEmpty(post.ImagemUrl))
                {
                    <img src="@post.ImagemUrl" alt="@post.Titulo" class="noticia-card-imagem" />
                }
                else
                {
                    <div class="img-placeholder noticia-card-imagem" aria-label="Imagem reservada para @post.Titulo">
                        <span>Imagem em breve</span>
                    </div>
                }
                <div class="noticia-card-corpo">
                    <h2>@post.Titulo</h2>
                    <p>@post.ResumoCurta</p>
                    <time datetime="@post.DataPublicacao.ToString("yyyy-MM-dd")">
                        @post.DataPublicacao.ToString("d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))
                    </time>
                </div>
            </a>
        }
    </div>
</section>

@if (Model.TotalPaginas > 1)
{
    <nav class="noticias-paginacao" aria-label="Paginação de notícias">
        <div class="container noticias-paginacao-inner">
            @if (Model.TemPaginaAnterior)
            {
                <a href="@Url.Action("Index", "Noticias", new { pagina = Model.PaginaAtual - 1 })" class="btn btn--primario">
                    ← Mais recentes
                </a>
            }

            <span class="noticias-paginacao-info">
                Página @Model.PaginaAtual de @Model.TotalPaginas
            </span>

            @if (Model.TemProximaPagina)
            {
                <a href="@Url.Action("Index", "Noticias", new { pagina = Model.PaginaAtual + 1 })" class="btn btn--primario">
                    Mais antigas →
                </a>
            }
        </div>
    </nav>
}