@* Views/Cursos/Detalhe.cshtml *@
@model AutoescolaReisSite.Models.CursoInfo

@{
    ViewData["Title"] = Model.Titulo;
}

<section class="curso-hero">
    <div class="container">
        <h1>@Model.Titulo</h1>
        @if (!string.IsNullOrEmpty(Model.Subtitulo))
        {
            <p class="curso-subtitulo">@Model.Subtitulo</p>
        }
    </div>
</section>

<section class="curso-conteudo">
    <div class="container curso-grid">

        <div class="curso-texto">

            <div class="curso-badge-grande">@Model.Codigo</div>

            @if (!string.IsNullOrEmpty(Model.TextoIntroducao))
            {
                <p class="curso-introducao">@Model.TextoIntroducao</p>
            }

            @if (!string.IsNullOrEmpty(Model.CategoriaNome))
            {
                <div class="curso-box curso-box--categoria">
                    <h2>@Model.CategoriaNome</h2>
                    <p>@Model.CategoriaDescricao</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Importante))
            {
                <div class="curso-box curso-box--importante">
                    <h3>IMPORTANTE</h3>
                    <p>@Model.Importante</p>
                </div>
            }

            @if (Model.Exigencias is { Count: > 0 })
            {
                <div class="curso-box curso-box--exigencias">
                    <h3>Exigências</h3>
                    <ul>
                        @foreach (var exigencia in Model.Exigencias)
                        {
                            <li>@exigencia</li>
                        }
                    </ul>
                </div>
            }

            @* Caso normal: uma única lista de etapas *@
            @if (Model.Etapas is { Count: > 0 })
            {
                <div class="curso-box curso-box--etapas">
                    <h3>Etapas para quem deseja fazer este curso</h3>
                    <ol>
                        @foreach (var etapa in Model.Etapas)
                        {
                            <li>@etapa</li>
                        }
                    </ol>
                </div>
            }

            @* Caso especial: Adição de Categoria, com etapas separadas por grupo (A / B) *@
            @if (Model.EtapasPorGrupo is { Count: > 0 })
            {
                foreach (var grupo in Model.EtapasPorGrupo)
                {
                    <div class="curso-box curso-box--etapas">
                        <h3>@grupo.Key</h3>
                        <ol>
                            @foreach (var etapa in grupo.Value)
                            {
                                <li>@etapa</li>
                            }
                        </ol>
                    </div>
                }
            }

        </div>

        <aside class="curso-cta">
            <ul class="curso-cta-tags">
                <li>Aulas teóricas 100% online</li>
                <li>Facilitamos o pagamento</li>
            </ul>

            <a href="@Url.Action("Index", "Matriculas")" class="btn btn--primario">
                Matricule-se aqui
            </a>

            <p class="curso-cta-whatsapp-label">Informações e Matrículas</p>
            <div class="cta-grupo">
                <a href="https://wa.me/5571982600856" target="_blank" rel="noopener" class="btn btn--whatsapp">
                    WhatsApp
                </a>
                <a href="tel:+557134507775" class="btn btn--ligar">
                    Ligar agora
                </a>
            </div>
        </aside>

    </div>
</section>